# Shared bearer secret required on POST /mcp. Leave empty to disable auth for local dev.
# Generate with: openssl rand -hex 32
MCP_TOKEN=

# Base URL of the Ehitisregister building data API.
EHR_BASE_URL=https://livekluster.ehr.ee/api/building

# Cluster root for the document, classifier and archive APIs. Defaults to the host
# of EHR_BASE_URL; set only to target a non-live cluster
# (prelivekluster / testkluster / devkluster).
EHR_ROOT_URL=https://livekluster.ehr.ee
